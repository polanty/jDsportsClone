# Server (serverless function)
# - Keep your STRIPE secret key private. Use the test key while developing.
STRIPE_SECRET_KEY=sk_test_your_secret_key_here

# Frontend (Create React App style environment variables must start with REACT_APP_)
# - This is the publishable key used by Stripe.js (safe to embed in frontend)
REACT_APP_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Optional Firebase client config (only if you will enable Firebase features)
REACT_APP_FIREBASE_API_KEY=your_firebase_api_key
REACT_APP_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your_project_id
REACT_APP_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
REACT_APP_FIREBASE_APP_ID=your_firebase_app_id
# If you use other Firebase features, add them here as needed.

# Optional: Netlify settings (if using Netlify CLI for local dev)
# You can set them with `netlify env:set KEY value` or put values in a .env (local use only)
# Example: NETLIFY_API_KEY=...
